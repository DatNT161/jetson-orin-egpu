#!/bin/bash
# Chuyển chế độ CUDA trên Jetson có eGPU.
#   igpu: gỡ nvidia_uvm  -> CUDA iGPU (libcuda nvgpu) chạy; eGPU KHÔNG chạy CUDA được.
#   dgpu: nạp nvidia_uvm -> CUDA eGPU chạy qua `dgpu <lệnh>`; CUDA iGPU hỏng (libcuda nvgpu
#         thấy /sys/module/nvidia_uvm thì dùng uvm bản upstream, không hiểu nvgpu).
#         Bật persistence mode: không có thì mỗi tiến trình CUDA mới mất ~20 s khởi động lại GPU (GSP firmware).
# Không có tham số: in chế độ hiện tại.
set -euo pipefail
SMI=/opt/nvidia/dgpu-595.99.02/bin/nvidia-smi
cur() { [ -d /sys/module/nvidia_uvm ] && echo dgpu || echo igpu; }
case "${1:-}" in
    "") cur; exit 0 ;;
    igpu|dgpu) ;;
    *) echo "Dùng: gpu-mode [igpu|dgpu]" >&2; exit 2 ;;
esac
# Gọi đúng đường dẫn thật để khớp luật NOPASSWD (30-sudoers-gpu-mode.sh), kể cả khi chạy qua symlink.
[ "$(id -u)" = 0 ] || exec sudo /usr/local/sbin/gpu-mode "$@"
if [ "$1" = dgpu ]; then
    modprobe nvidia_uvm
    /opt/nvidia/dgpu-595.99.02/bin/nvidia-modprobe -u -c=0
    LD_LIBRARY_PATH=/opt/nvidia/dgpu-595.99.02/lib "$SMI" -pm 1 >/dev/null
else
    LD_LIBRARY_PATH=/opt/nvidia/dgpu-595.99.02/lib "$SMI" -pm 0 >/dev/null 2>&1 || true
    if ! modprobe -r nvidia_uvm; then
        echo "nvidia_uvm đang bận — còn tiến trình CUDA trên eGPU:" >&2
        fuser -v /dev/nvidia-uvm 2>&1 | sed 's/^/  /' >&2 || true
        exit 1
    fi
fi
echo "gpu-mode: $(cur)"
