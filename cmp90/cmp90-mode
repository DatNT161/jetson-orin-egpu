#!/bin/bash
# Switch the eGPU driver modules between stock and the CMP 90HX unlock patch (cmpunlocker v0.1.28 rejoin15,
# ported from 610.43.03 to 595.99.02 — NOT tested on a real card).
#   stock: /lib/modules/$KVER/updates/dgpu        (stock open-gpu-kernel-modules 595.99.02)
#   cmp90: /lib/modules/$KVER/updates/dgpu-cmp90  (same version, patches 0014-0016)
# Only switches the override lines in /etc/nvidia-dgpu/depmod.conf; reload = reboot (nvidia.ko holds the card,
# cannot be unloaded live). Userspace /opt/nvidia/dgpu-595.99.02 and gpu-mode are shared, unchanged.
# No argument: print the selected and the loaded variant.
set -euo pipefail
KVER=$(uname -r)
W=${EGPU_DIR:-$(getent passwd "${SUDO_USER:-$USER}" | cut -d: -f6)/egpu}
SRC=$W/open-gpu-kernel-modules-595.99.02-cmp90/kernel-open
DST=/lib/modules/$KVER/updates/dgpu-cmp90
CONF=/etc/nvidia-dgpu/depmod.conf

sel() { grep -q 'updates/dgpu-cmp90' "$CONF" && echo cmp90 || echo stock; }
loaded() {
    [ -f /sys/module/nvidia/srcversion ] || { echo "not loaded"; return; }
    local s; s=$(cat /sys/module/nvidia/srcversion)
    if [ -f "$DST/nvidia.ko" ] && [ "$s" = "$(modinfo -F srcversion "$DST/nvidia.ko")" ]; then echo cmp90
    elif [ "$s" = "$(modinfo -F srcversion "/lib/modules/$KVER/updates/dgpu/nvidia.ko")" ]; then echo stock
    else echo "other ($s)"; fi
}
case "${1:-}" in
    "") echo "selected: $(sel) · loaded: $(loaded)"; exit 0 ;;
    stock|cmp90) ;;
    *) echo "Usage: cmp90-mode [stock|cmp90]" >&2; exit 2 ;;
esac
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

if [ "$1" = cmp90 ]; then
    for m in nvidia nvidia-modeset nvidia-drm nvidia-uvm; do
        [ -f "$SRC/$m.ko" ] || { echo "Missing $SRC/$m.ko — build not finished?"; exit 1; }
    done
    install -d "$DST"
    install -m644 "$SRC"/*.ko "$DST"/
    sed -i 's|updates/dgpu$|updates/dgpu-cmp90|' "$CONF"
else
    sed -i 's|updates/dgpu-cmp90$|updates/dgpu|' "$CONF"
fi
# Copy the conf + run depmod now like nv-load-display-modules.sh; remove the stamp so it redoes it at boot too.
rm -f /var/lib/nvidia/nv-display.stamp
cp "$CONF" /etc/depmod.d/nvidia-display.conf
depmod -a "$KVER"
echo "== override:"; grep '^override' "$CONF"
echo "== nvidia will load from: $(modinfo -n nvidia)"
echo "Selected: $(sel). Reboot to load. Check after boot: journalctl -k -b | grep -E 'CMP90|NVRM' ; dgpu nvidia-smi"
